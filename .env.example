# =============================================================================
# X-GEO root environment (Docker Compose interpolation)
# =============================================================================
# Copy to `.env` before running `docker compose up` (the Makefile does this for
# you: `make up` creates the file from this example when it is missing).
#
# This file only holds values consumed by docker-compose.yml itself. Every
# backend runtime variable lives in `backend/.env.example`.
# =============================================================================

# --- Postgres (pgvector image) ----------------------------------------------
POSTGRES_USER=xgeo
POSTGRES_PASSWORD=xgeo_dev
POSTGRES_DB=xgeo_db
POSTGRES_PORT=5432

# --- Redis (Celery broker + result backend) ---------------------------------
REDIS_PORT=6379

# --- Host port bindings -----------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Compose image tags -----------------------------------------------------
PGVECTOR_IMAGE=pgvector/pgvector:pg16
REDIS_IMAGE=redis:7-alpine
