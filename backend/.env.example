# =============================================================================
# X-GEO backend environment — copy to backend/.env (`make env` does this)
# =============================================================================
# Every variable below is optional in development: app/config.py ships safe
# defaults so the stack boots without a .env file. Supabase credentials become
# mandatory when ENVIRONMENT != development (enforced by a model validator).
# =============================================================================

# --- Application ------------------------------------------------------------
APP_NAME=X-GEO
APP_VERSION=0.1.0
ENVIRONMENT=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false                   # true => single-line JSON logs (containers)
ACCESS_LOG_ENABLED=true
# Create tables on startup from the SQLAlchemy models (dev convenience only;
# production must use `alembic upgrade head`).
AUTO_CREATE_TABLES=true

# --- Database ---------------------------------------------------------------
# Inside Docker Compose this is overridden to point at the `postgres` service.
DATABASE_URL=postgresql+asyncpg://xgeo:xgeo_dev@localhost:5432/xgeo_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# --- Redis / Celery ---------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
TASK_ALWAYS_EAGER=false          # true => run tasks inline (no worker needed)
TASK_TIME_LIMIT_SECONDS=300
TASK_SOFT_TIME_LIMIT_SECONDS=240
TASK_MAX_RETRIES=3

# --- Supabase Auth ----------------------------------------------------------
# Required outside development. Leave the placeholders to use the DEBUG-only
# development token endpoint (POST /api/v1/auth/dev-token).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_JWT_ALGORITHMS=["HS256","ES256","RS256"]
SUPABASE_JWT_AUDIENCE=authenticated
# Create a local user row on the first authenticated request.
AUTH_AUTO_PROVISION_USERS=true
# DEBUG-only: lets you mint a local JWT without a Supabase project.
AUTH_DEV_TOKEN_ENABLED=true

# --- OpenAI (Phase 3+: embeddings, simulations) -----------------------------
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
EMBEDDING_DIMENSIONS=1536

# --- Crawler ----------------------------------------------------------------
CRAWLER_ENGINE=scrapy            # scrapy | httpx | playwright
CRAWLER_USER_AGENT=X-GEO-Bot/1.0 (+https://x-geo.dev/bot)
CRAWLER_TIMEOUT_SECONDS=10
CRAWLER_MAX_RETRIES=3
CRAWLER_RESPECT_ROBOTS_TXT=true
CRAWLER_MAX_RESPONSE_BYTES=5000000
MAX_PAGES_PER_AUDIT=25
PLAYWRIGHT_TIMEOUT_MS=15000
PLAYWRIGHT_HEADLESS=true

# --- Chunking ---------------------------------------------------------------
CHUNK_SIZE_TOKENS=256
CHUNK_OVERLAP_TOKENS=32
CHUNK_MIN_TOKENS=16

# --- Security ---------------------------------------------------------------
# Comma separated or JSON list. In DEBUG the API also accepts any https? origin
# so sandbox/preview hosts work without extra configuration.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_HOSTS=*
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10
# Comma separated hostnames or CIDRs that bypass SSRF blocking (e.g. a staging
# server you own). Leave empty in production.
SSRF_ALLOWLIST=
